# Copy to .env (git-ignored) and adjust. All values are optional for development.
# SECRET_KEY=change-me
# DATABASE_URL=sqlite:///C:/path/to/filego.db
# STORAGE_DIR=storage
# MAX_UPLOAD_MB=100
# BUFFER_KB=256
# REGISTRATION_MODE=open
# CORS_ORIGINS=http://localhost:5173
# PORT=5000
# FRONTEND_DIST=C:/path/to/FileGo/dist   (default: the dist folder next to backend/)
